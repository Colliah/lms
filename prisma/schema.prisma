// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & USER MANAGEMENT (Existing)
// ============================================================

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  phoneNumber         String?
  phoneNumberVerified Boolean?
  role                UserRole  @default(USER)
  username            String?
  displayUsername     String?
  sessions            Session[]
  accounts            Account[]

  // Extended relations
  profile            UserProfile?
  preferences        UserPreferences?
  wordProgress       UserWordProgress[]
  wordReviews        UserWordReview[]
  grammarProgress    UserGrammarProgress[]
  grammarSubmissions UserGrammarSubmission[]
  streak             UserStreak?
  achievements       UserAchievement[]
  dailyActivities    DailyActivity[]
  studySessions      StudySession[]
  readingProgress    UserReadingProgress[]
  savedVocabulary    SavedVocabulary[]
  writings           UserWriting[]
  pronunciations     UserPronunciation[]
  analyticsSnapshots AnalyticsSnapshot[]
  learningPaths      LearningPath[]
  weaknessAreas      WeaknessArea[]

  @@unique([email])
  @@unique([phoneNumber])
  @@unique([username])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// ============================================================
// USER PROFILE & ONBOARDING
// ============================================================

enum ProficiencyLevel {
  A1 // Beginner
  A2 // Elementary
  B1 // Intermediate
  B2 // Upper Intermediate
  C1 // Advanced
  C2 // Proficient
}

enum LearningGoal {
  CONVERSATION
  BUSINESS
  TRAVEL
  ACADEMIC
  GENERAL
}

enum LearningStyle {
  VISUAL
  AUDITORY
  READING_WRITING
  KINESTHETIC
  MIXED
}

model UserProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLevel    ProficiencyLevel @default(A1)
  goals           LearningGoal[]
  interests       String[] // Topics the user is interested in
  dailyCommitment Int              @default(15) // Minutes per day
  learningStyle   LearningStyle    @default(MIXED)
  onboardingDone  Boolean          @default(false)
  assessmentScore Int? // Initial assessment score
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("user_profile")
}

model UserPreferences {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications  Boolean  @default(true)
  pushNotifications   Boolean  @default(true)
  dailyReminder       Boolean  @default(true)
  reminderTime        String   @default("09:00") // Format: "HH:MM"
  soundEffects        Boolean  @default(true)
  autoPlayAudio       Boolean  @default(true)
  showTranslations    Boolean  @default(true)
  interfaceLanguage   String   @default("en")
  translationLanguage String   @default("vi") // Vietnamese default
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("user_preferences")
}

// ============================================================
// VOCABULARY SYSTEM WITH SPACED REPETITION (SM-2)
// ============================================================

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  ARTICLE
  PHRASE
}

model Word {
  id           String             @id @default(cuid())
  word         String             @unique
  translation  String // Primary translation
  phonetic     String? // IPA pronunciation
  difficulty   ProficiencyLevel
  partOfSpeech PartOfSpeech
  definition   String // English definition
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  categories   WordCategory[]
  audios       WordAudio[]
  images       WordImage[]
  examples     ExampleSentence[]
  userProgress UserWordProgress[]
  savedByUsers SavedVocabulary[]

  @@index([difficulty])
  @@index([word])
  @@map("word")
}

model WordCategory {
  id          String   @id @default(cuid())
  name        String   @unique // e.g., "Business", "Travel", "Academic"
  description String?
  createdAt   DateTime @default(now())
  words       Word[]

  @@map("word_category")
}

model WordAudio {
  id       String @id @default(cuid())
  wordId   String
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  url      String // Audio file URL
  accent   String @default("US") // US, UK, AU, etc.
  duration Int? // Duration in seconds

  @@map("word_audio")
}

model WordImage {
  id          String  @id @default(cuid())
  wordId      String
  word        Word    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  url         String // Image URL
  description String? // Alt text

  @@map("word_image")
}

model ExampleSentence {
  id          String @id @default(cuid())
  wordId      String
  word        Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentence    String
  translation String
  highlight   String // The word form used in the sentence

  @@map("example_sentence")
}

enum ReviewQuality {
  AGAIN // 0 - Complete blackout
  HARD // 1 - Incorrect but remembered
  GOOD // 2 - Correct with hesitation
  EASY // 3 - Perfect recall
}

model UserWordProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  // SM-2 Algorithm fields
  easeFactor      Float    @default(2.5) // Ranges from 1.3 to 2.5+
  intervalDays    Int      @default(0) // Days until next review
  repetitionCount Int      @default(0) // Number of successful reviews
  nextReviewDate  DateTime

  // Status
  mastered     Boolean   @default(false) // 21 days interval reached
  lastReviewed DateTime?

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  reviews   UserWordReview[]

  @@unique([userId, wordId])
  @@index([userId, nextReviewDate])
  @@map("user_word_progress")
}

model UserWordReview {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressId String
  progress   UserWordProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)
  quality    ReviewQuality
  reviewedAt DateTime         @default(now())

  @@index([userId, reviewedAt])
  @@map("user_word_review")
}

// ============================================================
// GRAMMAR SYSTEM
// ============================================================

model GrammarTopic {
  id          String            @id @default(cuid())
  name        String            @unique // e.g., "Present Simple", "Articles"
  description String
  difficulty  ProficiencyLevel
  createdAt   DateTime          @default(now())
  exercises   GrammarExercise[]

  @@index([difficulty])
  @@map("grammar_topic")
}

enum ExerciseType {
  MULTIPLE_CHOICE
  FILL_IN_BLANK
  SENTENCE_CORRECTION
  MATCH_PATTERN
}

model GrammarExercise {
  id          String                  @id @default(cuid())
  topicId     String
  topic       GrammarTopic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title       String
  description String?
  difficulty  ProficiencyLevel
  createdAt   DateTime                @default(now())
  questions   GrammarQuestion[]
  progress    UserGrammarProgress[]
  submissions UserGrammarSubmission[]

  @@index([topicId, difficulty])
  @@map("grammar_exercise")
}

model GrammarQuestion {
  id            String          @id @default(cuid())
  exerciseId    String
  exercise      GrammarExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  type          ExerciseType
  question      String
  options       String[] // For multiple choice
  correctAnswer String
  explanation   String
  orderIndex    Int // Question order in exercise

  @@index([exerciseId])
  @@map("grammar_question")
}

model UserGrammarProgress {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      GrammarExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completed     Boolean         @default(false)
  score         Int? // Percentage
  attemptsCount Int             @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([userId, exerciseId])
  @@index([userId, completed])
  @@map("user_grammar_progress")
}

model UserGrammarSubmission {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    GrammarExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answers     Json // Map of questionId -> userAnswer
  score       Int // Percentage
  feedback    Json // Map of questionId -> isCorrect and explanation
  submittedAt DateTime        @default(now())

  @@index([userId, submittedAt])
  @@map("user_grammar_submission")
}

// ============================================================
// PROGRESS TRACKING & GAMIFICATION
// ============================================================

model UserStreak {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  freezesAvailable Int       @default(0) // Streak freeze items
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("user_streak")
}

enum AchievementType {
  VOCABULARY
  GRAMMAR
  READING
  WRITING
  SPEAKING
  STREAK
  GENERAL
}

model Achievement {
  id          String            @id @default(cuid())
  name        String            @unique
  description String
  type        AchievementType
  iconUrl     String?
  requirement Int // e.g., 100 words learned, 7 day streak
  createdAt   DateTime          @default(now())
  earnedBy    UserAchievement[]

  @@map("achievement")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
  @@index([userId, earnedAt])
  @@map("user_achievement")
}

model DailyActivity {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  wordsLearned   Int      @default(0)
  wordsReviewed  Int      @default(0)
  exercisesCount Int      @default(0)
  readingCount   Int      @default(0)
  writingCount   Int      @default(0)
  speakingCount  Int      @default(0)
  totalMinutes   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_activity")
}

model StudySession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String // "vocabulary", "grammar", "reading", etc.
  duration  Int // Minutes
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId, startedAt])
  @@map("study_session")
}

// ============================================================
// READING MODULE
// ============================================================

model ReadingPassage {
  id         String                @id @default(cuid())
  title      String
  content    String                @db.Text
  difficulty ProficiencyLevel
  topics     String[] // e.g., ["technology", "travel"]
  wordCount  Int
  audioUrl   String? // Optional narration
  createdAt  DateTime              @default(now())
  questions  ReadingQuestion[]
  progress   UserReadingProgress[]

  @@index([difficulty])
  @@map("reading_passage")
}

model ReadingQuestion {
  id          String         @id @default(cuid())
  passageId   String
  passage     ReadingPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  question    String
  options     String[] // For multiple choice
  answer      String
  explanation String?
  orderIndex  Int

  @@index([passageId])
  @@map("reading_question")
}

model UserReadingProgress {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  passageId      String
  passage        ReadingPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  completed      Boolean        @default(false)
  answers        Json? // Map of questionId -> answer
  score          Int? // Percentage
  readingTime    Int? // Seconds
  wordsPerMinute Int? // Calculated WPM
  completedAt    DateTime?
  createdAt      DateTime       @default(now())

  @@unique([userId, passageId])
  @@index([userId, completed])
  @@map("user_reading_progress")
}

model SavedVocabulary {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId  String
  word    Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  context String? // The sentence where user found the word
  savedAt DateTime @default(now())

  @@unique([userId, wordId])
  @@index([userId, savedAt])
  @@map("saved_vocabulary")
}

// ============================================================
// WRITING MODULE
// ============================================================

enum WritingType {
  SENTENCE_CONSTRUCTION
  PARAGRAPH
  EMAIL
  LETTER
  DESCRIPTIVE
  NARRATIVE
  ARGUMENTATIVE
}

enum UserRole {
  USER
  ADMIN
}

model WritingPrompt {
  id          String           @id @default(cuid())
  type        WritingType
  difficulty  ProficiencyLevel
  title       String
  prompt      String           @db.Text
  guidelines  String? // Tips or structure guidance
  minWords    Int              @default(50)
  maxWords    Int              @default(500)
  createdAt   DateTime         @default(now())
  submissions UserWriting[]

  @@index([difficulty, type])
  @@map("writing_prompt")
}

model UserWriting {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  promptId    String
  prompt      WritingPrompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  content     String           @db.Text
  wordCount   Int
  submittedAt DateTime         @default(now())
  feedback    WritingFeedback?

  @@index([userId, submittedAt])
  @@map("user_writing")
}

model WritingFeedback {
  id              String      @id @default(cuid())
  writingId       String      @unique
  writing         UserWriting @relation(fields: [writingId], references: [id], onDelete: Cascade)
  grammarScore    Int // 0-100
  vocabularyScore Int // 0-100
  structureScore  Int // 0-100
  overallScore    Int // Average
  grammarErrors   Json // Array of error objects
  suggestions     Json // Array of improvement suggestions
  strengths       String[]
  weaknesses      String[]
  generatedAt     DateTime    @default(now())

  @@map("writing_feedback")
}

// ============================================================
// SPEAKING MODULE
// ============================================================

model PronunciationExercise {
  id          String              @id @default(cuid())
  type        String // "word", "phrase", "sentence", "tongue_twister"
  content     String
  difficulty  ProficiencyLevel
  audioUrl    String // Native speaker reference
  phonetic    String?
  tips        String?
  createdAt   DateTime            @default(now())
  submissions UserPronunciation[]

  @@index([difficulty, type])
  @@map("pronunciation_exercise")
}

model UserPronunciation {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     PronunciationExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  recordingUrl String // User's recording
  score        Int? // 0-100 accuracy score
  feedback     String? // What to improve
  attemptedAt  DateTime              @default(now())

  @@index([userId, attemptedAt])
  @@map("user_pronunciation")
}

model ConversationScenario {
  id          String           @id @default(cuid())
  title       String
  description String
  difficulty  ProficiencyLevel
  topic       String // "introductions", "restaurant", "directions"
  dialogue    Json // Array of dialogue turns
  audioUrl    String?
  createdAt   DateTime         @default(now())

  @@index([difficulty, topic])
  @@map("conversation_scenario")
}

// ============================================================
// ANALYTICS & ADAPTIVE LEARNING
// ============================================================

model AnalyticsSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  vocabularyMastery  Int // Percentage
  grammarAccuracy    Int // Percentage
  readingSpeed       Int // WPM
  writingScore       Int // Average score
  pronunciationScore Int // Average score
  timeSpent          Int // Minutes
  createdAt          DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
  @@map("analytics_snapshot")
}

model LearningPath {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations Json // Array of recommended activities
  priority        String[] // Focus areas
  generatedAt     DateTime @default(now())
  validUntil      DateTime

  @@index([userId, validUntil])
  @@map("learning_path")
}

model WeaknessArea {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String // "vocabulary", "grammar", "pronunciation"
  specificArea String // e.g., "past_tense", "prepositions"
  severity     Int // 1-10
  suggestions  String[]
  identifiedAt DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([userId, category, resolvedAt])
  @@map("weakness_area")
}
